# این فایل را کپی کن و اسمش را .env بگذار. فایل .env هرگز نباید commit شود.

# --- الزامی ---
# کلید GapGPT (https://gapgpt.app) — بدون این سرور بالا نمی‌آید
GAPGPT_API_KEY=your_gapgpt_api_key_here

# --- اختیاری ---
# مدل زبانی (فرمت سازگار با OpenAI روی GapGPT)
GAPGPT_MODEL=gemini-2.5-flash-lite

# پورت سرور
PORT=3000

# رمز امضای توکن JWT پنل مشتری — در production حتماً یک مقدار تصادفی بلند بگذار
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-secret

# کلید رمزنگاری رمز شاپفای مشتری‌ها (AES-256-GCM) — باید با JWT_SECRET متفاوت باشد
# هشدار: تغییر این مقدار روی دیتابیس موجود، رمزهای ذخیره‌شده را غیرقابل‌بازیابی می‌کند
ENCRYPTION_SECRET=change-this-secret

# کلید API کاوه‌نگار (kavenegar.com) — برای ورود با کد پیامکی (OTP) به پنل.
# بدون این مقدار، بقیه‌ی سرور طبیعی اجرا می‌شود ولی /auth/otp/* خطا می‌دهد.


# کد پذیرنده (Merchant ID) زرین‌پال — برای خرید/تمدید اشتراک از پنل.
# بدون این مقدار، بقیه‌ی سرور طبیعی اجرا می‌شود ولی /api/billing/checkout خطا می‌دهد.
ZARINPAL_MERCHANT_ID=

# روی true بگذار تا از درگاه آزمایشی (sandbox) زرین‌پال استفاده شود، بدون کسر پول واقعی.
ZARINPAL_SANDBOX=false

# آدرس عمومی همین سرور - برای ساخت لینک بازگشت از درگاه پرداخت. اگر دامنه عوض شد، این را هم عوض کن.
PUBLIC_BASE_URL=https://api.beporsid.com

# شماره موبایل مدیر کل سیستم. فقط حسابی که با این شماره وارد شود بخش «مدیریت سیستم» را
# در داشبورد می‌بیند (دسترسی به همه‌ی فروشگاه‌ها، پرداخت‌ها و گفتگوها). چند شماره را با
# کاما جدا کن. اگر خالی بماند، هیچ‌کس مدیر نیست و داشبورد برای همه مثل حالت عادی است.
ADMIN_PHONES=


